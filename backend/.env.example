MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=smart_literacy_stewardship
JWT_SECRET_KEY=

LLM_PROVIDER=spark
SPARK_API_KEY=
SPARK_API_BASE=https://maas-api.cn-huabei-1.xf-yun.com/v2
SPARK_MODEL_ID=spark-x2.5-4b
SPARK_LORA_ID=0
SPARK_MAX_TOKENS=8192
SPARK_RESEARCH_ANALYSIS_MAX_TOKENS=4096
# Optional: use a faster/non-reasoning model for bounded research extraction.
SPARK_RESEARCH_ANALYSIS_MODEL_ID=spark-x2.5-1.7b
SPARK_TIMEOUT_SECONDS=120

# 研教智联 Assistant WebSocket provider. These values are distinct from
# SPARK_API_* used by the OpenAI-compatible course-design provider.
RESEARCH_AGENT_PROVIDER=spark_assistant
SPARK_ASSISTANT_APP_ID=
SPARK_ASSISTANT_API_KEY=
SPARK_ASSISTANT_API_SECRET=
RESEARCH_AGENT_URL=
RESEARCH_AGENT_DOMAIN=generalv3.5
RESEARCH_AGENT_TIMEOUT_SECONDS=120
RESEARCH_ANALYSIS_MAX_CHUNKS=6
RESEARCH_ANALYSIS_MAX_CONTEXT_CHARS=9000

# ==================================================
# Research RAG Embedding - Xfyun Native
# ==================================================
# XFYUN_EMBEDDING_* configures the native Xfyun Embedding HTTP/HMAC service.
# SPARK_ASSISTANT_* configures the Research Agent. Credentials are independent
# and must never be reused automatically. Never commit real credentials here.
# Aliyun Bailian OpenAI-compatible embedding is the current primary provider.
Aliyun_EMBEDDING_PROVIDER=openai_compatible
Aliyun_EMBEDDING_API_KEY=
Aliyun_EMBEDDING_URL=
Aliyun_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
Aliyun_EMBEDDING_DIMENSION=1024
Aliyun_EMBEDDING_BATCH_SIZE=25
Aliyun_EMBEDDING_TIMEOUT_SECONDS=60

# Xfyun Native is retained as an optional fallback provider.
EMBEDDING_PROVIDER=openai_compatible
XFYUN_EMBEDDING_APP_ID=
XFYUN_EMBEDDING_API_KEY=
XFYUN_EMBEDDING_API_SECRET=
XFYUN_EMBEDDING_URL=https://emb-cn-huabei-1.xf-yun.com/
XFYUN_EMBEDDING_DIMENSION=2560
XFYUN_EMBEDDING_MAX_CONCURRENCY=4
XFYUN_EMBEDDING_MAX_PAYLOAD_BYTES=2048
# Optional; fill only when required for your Xfyun account/protocol.
XFYUN_EMBEDDING_UID=
EMBEDDING_TIMEOUT_SECONDS=60

# ==================================================
# Research RAG Chunking / Retrieval
# ==================================================
KNOWLEDGE_BASE_CHUNK_SIZE=1000
KNOWLEDGE_BASE_CHUNK_OVERLAP=120
KNOWLEDGE_BASE_RETRIEVAL_CANDIDATE_K=10
KNOWLEDGE_BASE_RETRIEVAL_TOP_K=5
KNOWLEDGE_BASE_RRF_K=60
